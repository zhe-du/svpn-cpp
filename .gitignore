# 二进制产物一律不入库（双产物 svpn.exe / svpn-gui.exe），
# 发布物统一放 dist/ 打包，追溯靠 git tag + dist/RELEASE.txt 的源码指纹。

# 编译中间产物
*.o
build/
build_*.exe
test_*.exe

# 根目录构建输出（源码树里不保留二进制副本）
/svpn.exe
/svpn-gui.exe

# 运行期数据（日志 / pid / 缓存 / 备份，含本机信息）
runtime/
**/hosts.backup
**/wininet-backup.json
**/effective.json
**/*.pid
**/*.log

# 本机配置（含本机端口/模式改动，属运行时状态）
config.json

# 测试可执行文件与临时脚手架
tests/*.exe
tests/_*
tests/out*.txt
tests/out*.json
tests/err.txt

# 工具目录里的截图素材（体积大、可随时重拍；shot.py 等脚本要入库）
tools/*.bmp

# 团队协作临时产物（含本机 hosts 备份等）
_crew/tmp_*/
_crew/**/runtime/

# 发布产物：整个目录忽略，二进制不进源码树（靠 tag + RELEASE.txt 源码指纹追溯）
dist/
